<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Apple Design System Tokens from feimacode/open-design-agent-kit
    (claude-design-systems/apple & claude-design-systems/apple-music-ios)
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AppleBgColor">#FFFFFF</Color>
      <Color x:Key="AppleSurfaceColor">#F5F5F7</Color>
      <Color x:Key="AppleSurfaceWarmColor">#FBFBFD</Color>
      <Color x:Key="AppleSurfaceElevatedColor">#FFFFFF</Color>
      <Color x:Key="AppleFgColor">#1D1D1F</Color>
      <Color x:Key="AppleFg2Color">#424245</Color>
      <Color x:Key="AppleMutedColor">#6E6E73</Color>
      <Color x:Key="AppleMetaColor">#86868B</Color>
      <Color x:Key="AppleBorderColor">#D2D2D7</Color>
      <Color x:Key="AppleBorderSoftColor">#E8E8ED</Color>
      <Color x:Key="AppleAccentColor">#0071E3</Color>
      <Color x:Key="AppleAccentHoverColor">#0077ED</Color>
      <Color x:Key="AppleLinkColor">#0066CC</Color>
      <Color x:Key="AppleCalloutBgColor">#120071E3</Color>
      <Color x:Key="AppleSuccessColor">#16A34A</Color>
      <Color x:Key="AppleWarnColor">#EAB308</Color>
      <Color x:Key="AppleDangerColor">#DC2626</Color>

      <SolidColorBrush x:Key="AppleBgBrush" Color="{StaticResource AppleBgColor}" />
      <SolidColorBrush x:Key="AppleSurfaceBrush" Color="{StaticResource AppleSurfaceColor}" />
      <SolidColorBrush x:Key="AppleSurfaceWarmBrush" Color="{StaticResource AppleSurfaceWarmColor}" />
      <SolidColorBrush x:Key="AppleSurfaceElevatedBrush" Color="{StaticResource AppleSurfaceElevatedColor}" />
      <SolidColorBrush x:Key="AppleFgBrush" Color="{StaticResource AppleFgColor}" />
      <SolidColorBrush x:Key="AppleFg2Brush" Color="{StaticResource AppleFg2Color}" />
      <SolidColorBrush x:Key="AppleMutedBrush" Color="{StaticResource AppleMutedColor}" />
      <SolidColorBrush x:Key="AppleMetaBrush" Color="{StaticResource AppleMetaColor}" />
      <SolidColorBrush x:Key="AppleBorderBrush" Color="{StaticResource AppleBorderColor}" />
      <SolidColorBrush x:Key="AppleBorderSoftBrush" Color="{StaticResource AppleBorderSoftColor}" />
      <SolidColorBrush x:Key="AppleAccentBrush" Color="{StaticResource AppleAccentColor}" />
      <SolidColorBrush x:Key="AppleAccentHoverBrush" Color="{StaticResource AppleAccentHoverColor}" />
      <SolidColorBrush x:Key="AppleLinkBrush" Color="{StaticResource AppleLinkColor}" />
      <SolidColorBrush x:Key="AppleCalloutBgBrush" Color="{StaticResource AppleCalloutBgColor}" />
      <SolidColorBrush x:Key="AppleSuccessBrush" Color="{StaticResource AppleSuccessColor}" />
      <SolidColorBrush x:Key="AppleWarnBrush" Color="{StaticResource AppleWarnColor}" />
      <SolidColorBrush x:Key="AppleDangerBrush" Color="{StaticResource AppleDangerColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AppleBgColor">#000000</Color>
      <Color x:Key="AppleSurfaceColor">#1C1C1E</Color>
      <Color x:Key="AppleSurfaceWarmColor">#272729</Color>
      <Color x:Key="AppleSurfaceElevatedColor">#2A2A2C</Color>
      <Color x:Key="AppleFgColor">#FFFFFF</Color>
      <Color x:Key="AppleFg2Color">#EBEBF5</Color>
      <Color x:Key="AppleMutedColor">#98989D</Color>
      <Color x:Key="AppleMetaColor">#8E8E93</Color>
      <Color x:Key="AppleBorderColor">#38383A</Color>
      <Color x:Key="AppleBorderSoftColor">#2C2C2E</Color>
      <Color x:Key="AppleAccentColor">#0071E3</Color>
      <Color x:Key="AppleAccentHoverColor">#0077ED</Color>
      <Color x:Key="AppleLinkColor">#2997FF</Color>
      <Color x:Key="AppleCalloutBgColor">#202997FF</Color>
      <Color x:Key="AppleSuccessColor">#34C759</Color>
      <Color x:Key="AppleWarnColor">#FF9500</Color>
      <Color x:Key="AppleDangerColor">#FF3B30</Color>

      <SolidColorBrush x:Key="AppleBgBrush" Color="{StaticResource AppleBgColor}" />
      <SolidColorBrush x:Key="AppleSurfaceBrush" Color="{StaticResource AppleSurfaceColor}" />
      <SolidColorBrush x:Key="AppleSurfaceWarmBrush" Color="{StaticResource AppleSurfaceWarmColor}" />
      <SolidColorBrush x:Key="AppleSurfaceElevatedBrush" Color="{StaticResource AppleSurfaceElevatedColor}" />
      <SolidColorBrush x:Key="AppleFgBrush" Color="{StaticResource AppleFgColor}" />
      <SolidColorBrush x:Key="AppleFg2Brush" Color="{StaticResource AppleFg2Color}" />
      <SolidColorBrush x:Key="AppleMutedBrush" Color="{StaticResource AppleMutedColor}" />
      <SolidColorBrush x:Key="AppleMetaBrush" Color="{StaticResource AppleMetaColor}" />
      <SolidColorBrush x:Key="AppleBorderBrush" Color="{StaticResource AppleBorderColor}" />
      <SolidColorBrush x:Key="AppleBorderSoftBrush" Color="{StaticResource AppleBorderSoftColor}" />
      <SolidColorBrush x:Key="AppleAccentBrush" Color="{StaticResource AppleAccentColor}" />
      <SolidColorBrush x:Key="AppleAccentHoverBrush" Color="{StaticResource AppleAccentHoverColor}" />
      <SolidColorBrush x:Key="AppleLinkBrush" Color="{StaticResource AppleLinkColor}" />
      <SolidColorBrush x:Key="AppleCalloutBgBrush" Color="{StaticResource AppleCalloutBgColor}" />
      <SolidColorBrush x:Key="AppleSuccessBrush" Color="{StaticResource AppleSuccessColor}" />
      <SolidColorBrush x:Key="AppleWarnBrush" Color="{StaticResource AppleWarnColor}" />
      <SolidColorBrush x:Key="AppleDangerBrush" Color="{StaticResource AppleDangerColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
