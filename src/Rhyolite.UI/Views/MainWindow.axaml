<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Rhyolite.Views"
        mc:Ignorable="d" d:DesignWidth="1420" d:DesignHeight="880"
        Width="1420" Height="880"
        MinWidth="960" MinHeight="640"
        x:Class="Rhyolite.Views.MainWindow"
        Icon="avares://Rhyolite.UI/Assets/Rhyolite.ico"
        Title="Rhyolite — Local-First Knowledge Studio (Open-Design Multi-Theme)">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Meta+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Meta+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.KeyBindings>
  <views:MainView />
</Window>
