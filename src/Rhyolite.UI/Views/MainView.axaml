<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Rhyolite.ViewModels"
             xmlns:controls="clr-namespace:Rhyolite.Controls"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Rhyolite.Views.MainView"
             x:CompileBindings="False"
             FontFamily="{DynamicResource AppleUiFont}"
             Background="{DynamicResource AppleBgBrush}"
             Foreground="{DynamicResource AppleFgBrush}">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Meta+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Meta+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <!-- ========================================================================= -->
    <!-- AUTHENTIC OBSIDIAN DESKTOP WORKSPACE SHELL                                -->
    <!-- Col 0: Far-Left Vertical Icon Ribbon (46px)                               -->
    <!-- Col 1: Persistent Collapsible Left Vault Sidebar (260px)                  -->
    <!-- Col 2: Multi-Tab Document & Graph/Canvas/Bases/Study Workspace (*)        -->
    <!-- Col 3: Collapsible Right Backlinks, Outline & AI Copilot Inspector (290px)-->
    <!-- Row 1: Obsidian Bottom Telemetry & Word/Backlink Status Bar (28px)        -->
    <!-- ========================================================================= -->
    <Grid RowDefinitions="*,28" ColumnDefinitions="46,Auto,*,Auto">

      <!-- ===================================================================== -->
      <!-- COL 0: OBSIDIAN FAR-LEFT VERTICAL ICON RIBBON (46px)                  -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="0"
              Background="{DynamicResource AppleSurfaceWarmBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="5,8">
        <DockPanel LastChildFill="True">
          <!-- Bottom Ribbon Actions: Theme & Design Preset Switcher -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="5" HorizontalAlignment="Center">
            <Button Content="🎨"
                    Command="{Binding NextDesignSystemCommand}"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Cycle Design System Preset (open-design-agent-kit)" />
            <Button Content="🌗"
                    Command="{Binding ToggleAppleThemeCommand}"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Toggle Light / Dark Theme Variant" />
          </StackPanel>

          <!-- Top Ribbon Actions: Obsidian Workspace Switchers -->
          <StackPanel Spacing="5" HorizontalAlignment="Center">
            <Button Content="◧"
                    Command="{Binding ToggleLeftSidebarCommand}"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Toggle Left File Explorer Sidebar" />
            <Border Height="1" Background="{DynamicResource AppleBorderBrush}" Margin="4,2" />
            <Button Content="📄"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Studio"
                    Classes="apple-btn-primary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Note Studio &amp; Markdown Editor" />
            <Button Content="🕸️"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Graph"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Force-Directed Knowledge Graph View" />
            <Button Content="🎨"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Spatial Infinite .canvas Board" />
            <Button Content="🗃️"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Bases"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Bases Relational Table &amp; Kanban" />
            <Button Content="📅"
                    Command="{Binding OpenDailyNoteCommand}"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Today's Daily Note" />
            <Button Content="🧠"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Study"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open FSRS Spaced Repetition &amp; Snapshot Time-Machine" />
            <Button Content="🔌"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Protocol"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open MCP JSON-RPC 2.0, GraphQL &amp; P2P Mesh Console" />
            <Button Content="🛡️"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="DevEx"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open GitHub PR Review &amp; 1Password/KeePassXC DevEx Studio" />
            <Button Content="📱"
                    Command="{Binding SwitchScreenCommand}" CommandParameter="Mobile"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Mobile Companion Preview" />
            <Border Height="1" Background="{DynamicResource AppleBorderBrush}" Margin="4,2" />
            <Button Content="⌘"
                    Command="{Binding ToggleCommandPaletteCommand}"
                    Classes="apple-btn-secondary"
                    Width="34" Height="34" Padding="0" FontSize="14"
                    ToolTip.Tip="Open Command Palette (⌘P / Ctrl+P)" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===================================================================== -->
      <!-- COL 1: OBSIDIAN PERSISTENT LEFT SIDEBAR (FILES / SEARCH / BOOKMARKS)  -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="1"
              Width="260"
              IsVisible="{Binding IsLeftSidebarOpen}"
              Background="{DynamicResource AppleSurfaceBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="10,8">
        <DockPanel LastChildFill="True">
          <!-- Left Sidebar Top Tab Bar: Files | Search | Bookmarks -->
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
              <Button Grid.Column="0" Content="📁 Files"
                      Command="{Binding SetLeftSidebarTabCommand}" CommandParameter="Files"
                      Classes="apple-btn-secondary" Padding="6,4" FontSize="11" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="🔍 Search"
                      Command="{Binding SetLeftSidebarTabCommand}" CommandParameter="Search"
                      Classes="apple-btn-secondary" Padding="6,4" FontSize="11" HorizontalAlignment="Stretch" />
              <Button Grid.Column="2" Content="🔖 Pins"
                      Command="{Binding SetLeftSidebarTabCommand}" CommandParameter="Bookmarks"
                      Classes="apple-btn-secondary" Padding="6,4" FontSize="11" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Obsidian File Explorer Action Toolbar -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
              <Button Grid.Column="0" Content="＋ 📄 New Note"
                      Command="{Binding CreateNewNoteCommand}"
                      Classes="apple-btn-primary" Padding="8,5" FontSize="12" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="📅 Daily"
                      Command="{Binding OpenDailyNoteCommand}"
                      Classes="apple-btn-secondary" Padding="8,5" FontSize="12" />
            </Grid>

            <!-- Custom Vault Folder Switcher -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBox Grid.Column="0"
                       Text="{Binding VaultPathInput, Mode=TwoWay}"
                       PlaceholderText="Vault folder path..."
                       FontSize="11" Padding="7,4" />
              <Button Grid.Column="1" Content="📂"
                      Command="{Binding SwitchVaultDirectoryCommand}"
                      Classes="apple-btn-secondary" Padding="7,4" FontSize="11"
                      ToolTip.Tip="Switch Active Vault Directory" />
            </Grid>

            <!-- Live Vault Search / Tag Filter -->
            <TextBox Text="{Binding SearchFilter, Mode=TwoWay}"
                     PlaceholderText="🔍 Filter vault files or #tags…"
                     FontSize="12" Padding="8,5" />

            <!-- Bookmarks / Pinned Notes Section -->
            <Border Background="{DynamicResource AppleSurfaceWarmBrush}"
                    BorderBrush="{DynamicResource AppleBorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                    Padding="7,6">
              <StackPanel Spacing="3">
                <TextBlock Text="🔖 BOOKMARKED NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding PinnedNotes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.OpenWikiLinkCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4,2"
                              CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="{Binding Title, StringFormat='📌 {0}'}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource AppleFg2Brush}"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="🗂️ VAULT FILE EXPLORER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" Margin="2,2,0,0" />
          </StackPanel>

          <!-- Bottom-Left Obsidian Vault Switcher Footer -->
          <Border DockPanel.Dock="Bottom"
                  Background="{DynamicResource AppleSurfaceWarmBrush}"
                  BorderBrush="{DynamicResource AppleBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                  Padding="8,6" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="1">
                <TextBlock Text="🗄️ Rhyolite Vault" Classes="display-heading" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                <TextBlock Text="{Binding VaultSummaryText}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" VerticalAlignment="Center">
                <TextBlock Text="v1.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
              </Border>
            </Grid>
          </Border>

          <!-- Obsidian Vault File Tree ListBox -->
          <ListBox ItemsSource="{Binding VaultNotes}"
                   SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                   SelectionChanged="OnVaultNoteSelectionChanged"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="6,5" CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}" Margin="0,1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title, StringFormat='📄 {0}.md'}"
                               Classes="display-heading"
                               FontSize="12"
                               Foreground="{DynamicResource AppleFgBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                      <TextBlock Text="{Binding WordCount, StringFormat='· {0}w'}" FontSize="10" Foreground="{DynamicResource AppleMetaBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===================================================================== -->
      <!-- COL 2: OBSIDIAN MULTI-TAB CENTER WORKSPACE                            -->
      <!-- ===================================================================== -->
      <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,Auto,*">

        <!-- ROW 0: OBSIDIAN DOCUMENT TAB BAR + MULTI-DESIGN SYSTEM PRESET STRIP -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppleSurfaceBrush}"
                BorderBrush="{DynamicResource AppleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <!-- Left: Obsidian Workspace Tabs -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Studio"
                        Classes="apple-btn-primary" Padding="10,5" FontSize="12">
                  <TextBlock Text="{Binding SelectedNote.Title, StringFormat='📄 {0}.md  ✕', FallbackValue='📄 Active Note.md  ✕'}" />
                </Button>
                <Button Content="🕸️ Graph.view" Command="{Binding SwitchScreenCommand}" CommandParameter="Graph" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="🎨 System.canvas" Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="🗃️ Roadmap.base" Command="{Binding SwitchScreenCommand}" CommandParameter="Bases" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="🧠 FSRS Deck" Command="{Binding SwitchScreenCommand}" CommandParameter="Study" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="🔌 MCP Mesh" Command="{Binding SwitchScreenCommand}" CommandParameter="Protocol" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="🛡️ PR #142" Command="{Binding SwitchScreenCommand}" CommandParameter="DevEx" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="📱 Mobile" Command="{Binding SwitchScreenCommand}" CommandParameter="Mobile" Classes="apple-btn-secondary" Padding="9,5" FontSize="11" />
                <Button Content="＋" Command="{Binding CreateNewNoteCommand}" Classes="apple-btn-secondary" Padding="8,5" FontSize="12" ToolTip.Tip="New Note Tab (⌘N)" />
              </StackPanel>
            </ScrollViewer>

            <!-- Right: Live Design System Switcher & Right Sidebar Toggle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="◀" Command="{Binding PreviousDesignSystemCommand}" Classes="apple-btn-secondary" Padding="6,4" FontSize="11" />
              <ComboBox ItemsSource="{Binding DesignSystems}"
                        SelectedItem="{Binding SelectedDesignSystem, Mode=TwoWay}"
                        Width="150" FontSize="11" Padding="6,3" />
              <Button Content="▶" Command="{Binding NextDesignSystemCommand}" Classes="apple-btn-secondary" Padding="6,4" FontSize="11" />
              <Button Content="{Binding ThemeButtonLabel}" Command="{Binding ToggleAppleThemeCommand}" Classes="apple-btn-secondary" Padding="8,4" FontSize="11" />
              <Button Content="◨" Command="{Binding ToggleRightSidebarCommand}" Classes="apple-btn-secondary" Padding="7,4" FontSize="12" ToolTip.Tip="Toggle Right Backlinks &amp; Outline Sidebar" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ROW 1: OBSIDIAN BREADCRUMB BAR + EDITOR MODE SWITCHER + 9 DESIGN SYSTEM PILLS -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppleSurfaceWarmBrush}"
                BorderBrush="{DynamicResource AppleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <!-- Left: Obsidian Vault Breadcrumb + Note Title Rename/Pin/Delete -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="🗄️ Vault ›" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveNoteFolderBreadcrumb, StringFormat='{}{0} ›'}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                <TextBox Text="{Binding EditableNoteTitle, Mode=TwoWay}"
                         Classes="display-heading"
                         Width="210" FontSize="12" Padding="6,3" />
                <Button Content="✏️ Rename" Command="{Binding RenameActiveNoteCommand}" Classes="apple-btn-secondary" Padding="7,3" FontSize="11" />
                <Button Content="📌 Pin" Command="{Binding TogglePinActiveNoteCommand}" Classes="apple-btn-secondary" Padding="7,3" FontSize="11" />
                <Button Content="🗑️" Command="{Binding DeleteActiveNoteCommand}" Classes="apple-btn-secondary" Padding="7,3" FontSize="11" ToolTip.Tip="Delete Active Note" />
              </StackPanel>

              <!-- Right: Obsidian Source / Live Split / Reading View Switcher -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="✏️ Source" Command="{Binding SetEditorModeCommand}" CommandParameter="Source" Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
                <Button Content="◫ Split" Command="{Binding SetEditorModeCommand}" CommandParameter="Split" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
                <Button Content="📖 Reading" Command="{Binding SetEditorModeCommand}" CommandParameter="Reading" Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
                <Button Content="💾 Save" Command="{Binding SaveActiveNoteCommand}" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
              </StackPanel>
            </Grid>

            <!-- 9 Design System Quick-Switch Pills + Live Component/Font Style Badge -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="DESIGN:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <Button Content="🍎 Apple" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="apple" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="📐 Linear" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="linear-app" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="📝 Notion" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="notion" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="▲ Vercel" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="vercel" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="✴️ Claude" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="claude" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="🐙 GitHub" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="github" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="🚀 Raycast" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="raycast" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="💳 Stripe" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="stripe" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                <Button Content="⚡ Supabase" Command="{Binding SwitchDesignSystemCommand}" CommandParameter="supabase" Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding ActiveDesignSubtitleText}"
                         FontSize="10"
                         Foreground="{DynamicResource AppleLinkBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 2: ACTIVE WORKSPACE BODY (SCREENS 1 THROUGH 8)                  -->
        <!-- =================================================================== -->
        <Grid Grid.Row="2">

          <!-- SCREEN 1: OBSIDIAN NOTE STUDIO (INLINE YAML PROPERTIES + HYBRID SPLIT EDITOR) -->
          <Grid IsVisible="{Binding IsStudioView}" RowDefinitions="Auto,*,Auto" Margin="14,10" RowSpacing="10">

            <!-- Obsidian 1.4+ Inline YAML Frontmatter Properties Accordion -->
            <Border Grid.Row="0" Classes="apple-surface-card" Padding="12,8">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Grid.Column="0"
                          Content="🏷️ Properties (YAML Frontmatter)"
                          Command="{Binding TogglePropertiesAccordionCommand}"
                          Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ActiveDesignSubtitleText}"
                             FontSize="11"
                             Foreground="{DynamicResource AppleLinkBrush}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <TextBox Text="{Binding NewPropertyKey, Mode=TwoWay}" PlaceholderText="property key" Width="95" FontSize="11" Padding="6,3" />
                    <TextBox Text="{Binding NewPropertyValue, Mode=TwoWay}" PlaceholderText="value" Width="110" FontSize="11" Padding="6,3" />
                    <Button Content="＋ Add Property" Command="{Binding UpsertFrontmatterPropertyCommand}" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
                  </StackPanel>
                </Grid>

                <WrapPanel IsVisible="{Binding IsPropertiesExpanded}" Orientation="Horizontal">
                  <ItemsControl ItemsSource="{Binding ActiveProperties}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-pill"
                                Background="{DynamicResource AppleBgBrush}"
                                Margin="0,2,6,2" Padding="9,3">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleMutedBrush}" />
                            <TextBlock Text=":" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                            <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppleFgBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{Binding ActiveTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-pill"
                                Background="{DynamicResource AppleCalloutBgBrush}"
                                Margin="0,2,6,2" Padding="9,3">
                          <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Hybrid 3-Mode Markdown Source & Editorial Reading View -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
              <!-- Left Pane: Raw Markdown Source Editor -->
              <Border Grid.Column="0"
                      Grid.ColumnSpan="{Binding SourceEditorColumnSpan}"
                      IsVisible="{Binding IsSourceEditorVisible}"
                      Classes="apple-card">
                <DockPanel LastChildFill="True">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="MARKDOWN SOURCE (.MD)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedNote.RelativePath}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                  <TextBox Text="{Binding EditorMarkdownText, Mode=TwoWay}"
                           Classes="mono-code"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="21"
                           BorderThickness="0"
                           Background="Transparent" />
                </DockPanel>
              </Border>

              <!-- Right Pane: Obsidian Editorial Reading & Live Callout / WikiLink Preview -->
              <Border Grid.Column="{Binding ReadingPreviewGridColumn}"
                      Grid.ColumnSpan="{Binding ReadingPreviewColumnSpan}"
                      IsVisible="{Binding IsReadingPreviewVisible}"
                      Classes="apple-card">
                <ScrollViewer>
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="LIVE READING VIEW &amp; WIKILINK GRAPH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                      <Border Grid.Column="1" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}">
                        <TextBlock Text="{Binding SelectedDesignSystem.Name}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                      </Border>
                    </Grid>

                    <TextBlock Text="{Binding SelectedNote.Title}"
                               Classes="display-heading"
                               FontSize="22"
                               Foreground="{DynamicResource AppleFgBrush}"
                               TextWrapping="Wrap" />

                    <!-- Clickable Outgoing [[WikiLinks]] -->
                    <ItemsControl ItemsSource="{Binding ActiveOutgoingLinks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding $parent[UserControl].DataContext.OpenWikiLinkCommand}"
                                  CommandParameter="{Binding TargetTitle}"
                                  Classes="apple-btn-secondary"
                                  Padding="8,3" Margin="0,0,5,5" FontSize="11">
                            <TextBlock Text="{Binding TargetTitle, StringFormat='↗ [[{0}]]'}" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="SemiBold" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rendered Obsidian Callout Cards (> [!NOTE], > [!TIP], etc.) -->
                    <ItemsControl ItemsSource="{Binding ActiveCallouts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource AppleCalloutBgBrush}"
                                  BorderBrush="{DynamicResource AppleLinkBrush}"
                                  BorderThickness="3,1,1,1"
                                  CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                                  Padding="10,8" Margin="0,3">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="12" Foreground="{DynamicResource AppleLinkBrush}" />
                              <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Editorial Formatted Reading Body -->
                    <TextBlock Text="{Binding ReadingPreviewBodyText}"
                               FontSize="13.5"
                               LineHeight="22"
                               Foreground="{DynamicResource AppleFg2Brush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>

            <!-- Bottom Strip of Studio: Interactive Task Checklists -->
            <Border Grid.Row="2" Classes="apple-surface-card" Padding="12,8">
              <StackPanel Spacing="4">
                <TextBlock Text="✅ INTERACTIVE NOTE TASKS (CLICK TO TOGGLE IN .MD)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveTasks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AppleBgBrush}"
                              BorderBrush="{DynamicResource AppleBorderSoftBrush}"
                              BorderThickness="1"
                              CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                              Padding="8,3" Margin="0,2,8,2">
                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                  Content="{Binding Text}"
                                  Command="{Binding $parent[UserControl].DataContext.ToggleTaskCompletionCommand}"
                                  CommandParameter="{Binding}"
                                  FontSize="11" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- SCREEN 2: OBSIDIAN FORCE-DIRECTED KNOWLEDGE GRAPH -->
          <Grid IsVisible="{Binding IsGraphView}" ColumnDefinitions="*,270" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card" ClipToBounds="True" Padding="0">
              <controls:KnowledgeGraphControl x:Name="GraphCanvas"
                                              Nodes="{Binding GraphNodes}"
                                              Edges="{Binding GraphEdges}"
                                              DesignPresetId="{Binding SelectedDesignSystem.Id}" />
            </Border>
            <Border Grid.Column="1" Classes="apple-card">
              <StackPanel Spacing="10">
                <TextBlock Text="🕸️ Graph Topology" Classes="display-heading" FontSize="17" Foreground="{DynamicResource AppleFgBrush}" />
                <TextBlock Text="{Binding SelectedGraphNodeInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                <Button Content="📄 Open Selected Note in Studio" Command="{Binding OpenSelectedGraphNoteCommand}" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                <Border Classes="apple-surface-card" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="PRIMARY HUB (PAGERANK)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                    <TextBlock Text="{Binding TopologyHubLabel}" Classes="display-heading" FontSize="14" Foreground="{DynamicResource AppleFgBrush}" />
                    <TextBlock Text="{Binding TopologyClusteringLabel}" FontSize="11" Foreground="{DynamicResource AppleSuccessBrush}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Repulsion Force" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" />
                <Slider Minimum="60" Maximum="300" Value="{Binding GraphRepulsion}" />
                <TextBlock Text="Ideal Link Distance" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" />
                <Slider Minimum="50" Maximum="200" Value="{Binding GraphLinkDistance}" />
                <Button Content="⟳ Re-stabilize Force Graph" Command="{Binding RecenterGraphCommand}" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- SCREEN 3: OBSIDIAN SPATIAL INFINITE .CANVAS BOARD -->
          <Grid IsVisible="{Binding IsCanvasView}" RowDefinitions="Auto,*" Margin="14,10" RowSpacing="10">
            <Border Grid.Row="0" Classes="apple-surface-card" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="🎨 Obsidian Spatial Canvas (.canvas JSON Spec)" Classes="display-heading" FontSize="15" />
                  <TextBlock Text="Drag cards on the infinite grid · Edit selected card title &amp; body below" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding SelectedCanvasCardTitle, Mode=TwoWay}" PlaceholderText="Card title" Width="150" FontSize="11" />
                <TextBox Grid.Column="2" Text="{Binding SelectedCanvasCardBody, Mode=TwoWay}" PlaceholderText="Card markdown body" Width="180" FontSize="11" />
                <Button Grid.Column="3" Content="✓ Update Card" Command="{Binding UpdateSelectedCanvasCardCommand}" Classes="apple-btn-secondary" />
                <Button Grid.Column="4" Content="＋ Add Card" Command="{Binding AddCanvasCardCommand}" Classes="apple-btn-primary" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="apple-card" ClipToBounds="True" Padding="0">
              <controls:SpatialCanvasControl x:Name="CanvasBoard"
                                             Document="{Binding CanvasDoc}"
                                             DesignPresetId="{Binding SelectedDesignSystem.Id}"
                                             SelectedCardId="{Binding SelectedCanvasCardId}" />
            </Border>
          </Grid>

          <!-- SCREEN 4: OBSIDIAN BASES (RELATIONAL TABLE & KANBAN BOARD) -->
          <Grid IsVisible="{Binding IsBasesView}" RowDefinitions="Auto,*" Margin="14,10" RowSpacing="10">
            <Border Grid.Row="0" Classes="apple-surface-card" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="🗃️ Obsidian Bases — Zero-Setup YAML Frontmatter Database" Classes="display-heading" FontSize="16" />
                  <TextBlock Text="Live relational projection over vault .md YAML properties" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="📋 Table View" Command="{Binding ShowBasesTableCommand}" Classes="apple-btn-primary" />
                <Button Grid.Column="2" Content="📊 Kanban Board" Command="{Binding ShowBasesKanbanCommand}" Classes="apple-btn-secondary" />
              </Grid>
            </Border>

            <Border Grid.Row="1" IsVisible="{Binding IsBasesTableMode}" Classes="apple-card">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding DatabaseRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10,8" BorderBrush="{DynamicResource AppleBorderSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="2*,1.1*,1.2*,0.9*,0.7*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" />
                          <Border Grid.Column="1" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Subsystem}" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                          <TextBlock Grid.Column="3" Text="{Binding Priority}" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" />
                          <TextBlock Grid.Column="4" Text="{Binding WordCount, StringFormat='{}{0} words'}" FontSize="11" Foreground="{DynamicResource AppleMetaBrush}" />
                          <Button Grid.Column="5" Content="⟳ Status" Command="{Binding $parent[UserControl].DataContext.CycleRowStatusCommand}" CommandParameter="{Binding}" Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
                          <Button Grid.Column="6" Content="📄 Open" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <ItemsControl Grid.Row="1" IsVisible="{Binding IsBasesKanbanMode}" ItemsSource="{Binding KanbanColumns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="apple-surface-card" Margin="5">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding StatusName}" Classes="display-heading" FontSize="14" Foreground="{DynamicResource AppleFgBrush}" />
                      <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="apple-card" Margin="0,4">
                              <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subsystem}" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Button Content="📄 Open" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="7,3" FontSize="10" />
                                  <Button Content="⟳ Status" Command="{Binding $parent[UserControl].DataContext.CycleRowStatusCommand}" CommandParameter="{Binding}" Classes="apple-btn-secondary" Padding="7,3" FontSize="10" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- SCREEN 5: FSRS v4 SPACED REPETITION & SNAPSHOT TIME-MACHINE -->
          <Grid IsVisible="{Binding IsStudyView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <StackPanel Spacing="12">
                <Border Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="FSRS v4 Spaced Repetition Memory Scheduler" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                </Border>
                <TextBlock Text="🧠 Active Recall Flashcard Deck" Classes="display-heading" FontSize="19" />
                <Border Classes="apple-surface-card">
                  <StackPanel Spacing="10">
                    <TextBlock Text="QUESTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                    <TextBlock Text="{Binding FlashcardQuestion}" Classes="display-heading" FontSize="16" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                    <Button Content="👁️ Flip / Hide-Reveal Answer" Command="{Binding ToggleFlashcardAnswerCommand}" Classes="apple-btn-secondary" HorizontalAlignment="Left" />
                    <StackPanel IsVisible="{Binding IsFlashcardAnswerRevealed}" Spacing="4">
                      <TextBlock Text="ANSWER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                      <TextBlock Text="{Binding FlashcardAnswer}" FontSize="13.5" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding FlashcardMeta}" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" Content="1 · Again" Command="{Binding RateFlashcardCommand}" CommandParameter="Again" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="2 · Hard" Command="{Binding RateFlashcardCommand}" CommandParameter="Hard" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="2" Content="3 · Good" Command="{Binding RateFlashcardCommand}" CommandParameter="Good" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="3" Content="4 · Easy" Command="{Binding RateFlashcardCommand}" CommandParameter="Easy" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                    <TextBlock Grid.Column="0" Text="⏱️ Snapshot Time-Machine" Classes="display-heading" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="📸 Milestone" Command="{Binding SaveMilestoneSnapshotCommand}" Classes="apple-btn-secondary" Padding="8,4" FontSize="11" />
                    <Button Grid.Column="2" Content="⏪ Restore" Command="{Binding RestorePreviousSnapshotCommand}" Classes="apple-btn-primary" Padding="8,4" FontSize="11" />
                  </Grid>
                  <TextBlock Text="LCS line-by-line delta stored in .rhyolite/cache.db" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding ActiveDiffLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="7,3" Margin="0,1" CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}" Background="{DynamicResource AppleSurfaceBrush}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Prefix}" Classes="mono-code" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" />
                            <TextBlock Text="{Binding Text}" Classes="mono-code" FontSize="11" Foreground="{DynamicResource AppleFgBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <!-- SCREEN 6: MCP JSON-RPC 2.0 + GRAPHQL + P2P MESH & WORKSPACE CONNECTORS -->
          <Grid IsVisible="{Binding IsProtocolView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <TextBlock Text="⚡ MCP JSON-RPC 2.0 &amp; GraphQL Live Executor" Classes="display-heading" FontSize="18" />
                  <TextBox Text="{Binding ProtocolConsoleInput}" Classes="mono-code" AcceptsReturn="True" TextWrapping="Wrap" Height="75" FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="▶ Run MCP JSON-RPC 2.0" Command="{Binding ExecuteMcpRpcCommand}" Classes="apple-btn-primary" />
                    <Button Content="▶ Run GraphQL Query" Command="{Binding ExecuteGraphQlSampleCommand}" Classes="apple-btn-secondary" />
                  </StackPanel>
                </StackPanel>
                <TextBox Text="{Binding ProtocolConsoleOutput}" Classes="mono-code" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11.5" Background="{DynamicResource AppleSurfaceBrush}" />
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Classes="apple-card">
              <StackPanel Spacing="10">
                <TextBlock Text="🔄 Bladbase &amp; Docmost Connectors" Classes="display-heading" FontSize="17" />
                <TextBlock Text="Bi-directional HLC CRDT sync with Bladbase workspaces and Docmost wiki spaces." FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="🔄 Sync Bladbase" Command="{Binding SyncBladbaseCommand}" Classes="apple-btn-primary" />
                  <Button Content="🔄 Sync Docmost" Command="{Binding SyncDocmostCommand}" Classes="apple-btn-secondary" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- SCREEN 7: ENTERPRISE GITHUB PR STUDIO & 1PASSWORD / KEEPASSXC DEVEX -->
          <Grid IsVisible="{Binding IsDevExView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="🛡️ GitHub PR Review &amp; Secret Redaction Studio" Classes="display-heading" FontSize="18" />
                  <Grid ColumnDefinitions="*,85,Auto,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding GitHubRepoInput, Mode=TwoWay}" PlaceholderText="owner/repo" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding GitHubPrNumberInput, Mode=TwoWay}" PlaceholderText="PR #" FontSize="12" />
                    <Button Grid.Column="2" Content="🔄 Fetch PR" Command="{Binding RefreshGitHubPrPreviewCommand}" Classes="apple-btn-secondary" />
                    <Button Grid.Column="3" Content="📥 Pull to Vault" Command="{Binding ImportGitHubPrToVaultCommand}" Classes="apple-btn-primary" />
                  </Grid>
                  <TextBlock Text="{Binding GitHubPrHeaderText}" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding GitHubPrMetaText}" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding ActivePrComments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-surface-card" Margin="0,3" Padding="10,7">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Author, StringFormat='@{0}'}" Classes="display-heading" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                            <TextBlock Text="{Binding FilePath}" Classes="mono-code" FontSize="10.5" Foreground="{DynamicResource AppleLinkBrush}" />
                            <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Column="1" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="🔐 1Password CLI (op) &amp; KeePassXC Guardrails" Classes="display-heading" FontSize="16" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="🔑 1Password Scan" Command="{Binding RunOnePasswordScanCommand}" Classes="apple-btn-primary" Margin="0,0,6,6" />
                    <Button Content="🛡️ KeePassXC Scan" Command="{Binding RunKeePassScanCommand}" Classes="apple-btn-secondary" Margin="0,0,6,6" />
                    <Button Content="⚠️ Override Guardrail" Command="{Binding OverrideRunbookGuardrailCommand}" Classes="apple-btn-secondary" Margin="0,0,6,6" />
                  </WrapPanel>
                </StackPanel>
                <TextBox Text="{Binding DevExTerminalOutput}" Classes="mono-code" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11.5" Background="{DynamicResource AppleSurfaceBrush}" />
              </DockPanel>
            </Border>
          </Grid>

          <!-- SCREEN 8: MOBILE COMPANION SHELL -->
          <Grid IsVisible="{Binding IsMobileView}" ColumnDefinitions="*,410,*" Margin="14,10">
            <Border Grid.Column="1" Classes="apple-card" Padding="18">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <TextBlock Text="📱 Rhyolite Mobile (iOS &amp; Android)" Classes="display-heading" FontSize="18" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding MobileQuickCaptureText, Mode=TwoWay}" PlaceholderText="Quick thought or #tag..." />
                    <Button Grid.Column="1" Content="Capture" Command="{Binding MobileQuickCaptureCommand}" Classes="apple-btn-primary" />
                  </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding VaultNotes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         SelectionChanged="OnVaultNoteSelectionChanged"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="apple-surface-card" Margin="0,3" Padding="10,7">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="13" />
                          <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===================================================================== -->
      <!-- COL 3: OBSIDIAN COLLAPSIBLE RIGHT SIDEBAR (BACKLINKS / OUTLINE / AI)  -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="3"
              Width="285"
              IsVisible="{Binding IsRightSidebarOpen}"
              Background="{DynamicResource AppleSurfaceBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="1,0,0,0"
              Padding="10,8">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="🔗 BACKLINKS · 📑 OUTLINE · ✦ AI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />

            <!-- Document Outline (TOC) -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="4">
                <TextBlock Text="📑 DOCUMENT OUTLINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveHeadings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.JumpToHeadingCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4,2"
                              CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="{Binding Text, StringFormat='§ {0}'}" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Linked Mentions (Backlinks) -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="5">
                <TextBlock Text="🔗 LINKED MENTIONS (BACKLINKS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveBacklinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}"
                              CommandParameter="{Binding SourceNotePath}"
                              Classes="apple-btn-secondary"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,5" Margin="0,2">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SourceNotePath, StringFormat='↩ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ContextSnippet}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Unlinked Mentions (1-Click Link) -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="5">
                <TextBlock Text="🔍 UNLINKED MENTIONS (1-CLICK LINK)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveUnlinkedMentions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="7,5" CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}" Background="{DynamicResource AppleSurfaceBrush}" Margin="0,2">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button Grid.Column="0"
                                    Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}"
                                    CommandParameter="{Binding SourceNotePath}"
                                    Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding SourceNoteTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleFgBrush}" />
                            </Button>
                            <Button Grid.Column="1" Content="🔗 Link [[]]"
                                    Command="{Binding $parent[UserControl].DataContext.ConvertUnlinkedMentionCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="apple-btn-secondary" Padding="6,2" FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding ContextSnippet}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Semantically Related Notes -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="5">
                <TextBlock Text="🧠 SEMANTICALLY RELATED NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding SemanticSuggestions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}"
                              CommandParameter="{Binding RelativePath}"
                              Classes="apple-btn-secondary"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,5" Margin="0,2">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding NoteTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                          <TextBlock Text="{Binding SimilarityScore, StringFormat='Cosine similarity: {0:P0}'}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Local RAG Vault Copilot -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="6">
                <TextBlock Text="✦ LOCAL VAULT RAG COPILOT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                <TextBox Text="{Binding CopilotPrompt}" FontSize="11.5" />
                <Button Content="Ask Vault with Citations" Command="{Binding ExecuteAskCopilotCommand}" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding CopilotResponseText}" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ===================================================================== -->
      <!-- ROW 1: OBSIDIAN BOTTOM STATUS BAR (28px)                              -->
      <!-- ===================================================================== -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
              Background="{DynamicResource AppleSurfaceWarmBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="10,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding SaveTelemetryText}" FontSize="11" Foreground="{DynamicResource AppleSuccessBrush}" FontWeight="Medium" />
            <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
            <TextBlock Text="{Binding StatusBarRightText}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="{Binding ObsidianBottomRightStatusText}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppleFg2Brush}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- MODAL OVERLAY: SEARCHABLE COMMAND PALETTE (⌘P / Ctrl+P)                   -->
    <!-- ========================================================================= -->
    <Border IsVisible="{Binding IsCommandPaletteOpen}"
            Background="#88000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Width="580"
              VerticalAlignment="Top"
              Margin="0,80,0,0"
              Classes="apple-card"
              Padding="18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="⌘P Obsidian Command Palette &amp; Quick Switcher" Classes="display-heading" FontSize="16" />
            <Button Grid.Column="1" Content="✕ Esc" Command="{Binding CloseCommandPaletteCommand}" Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
          </Grid>

          <TextBox Text="{Binding CommandPaletteFilter, Mode=TwoWay}"
                   PlaceholderText="Type a note title, #tag, or command and press Enter…"
                   FontSize="13">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ExecuteFirstCommandPaletteMatchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>

          <ItemsControl ItemsSource="{Binding FilteredCommandPaletteNotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding $parent[UserControl].DataContext.OpenWikiLinkCommand}"
                        CommandParameter="{Binding}"
                        Classes="apple-btn-secondary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding Title, StringFormat='📄 {0}'}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
