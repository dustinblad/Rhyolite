<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Rhyolite.ViewModels"
             xmlns:controls="clr-namespace:Rhyolite.Controls"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Rhyolite.Views.MainView"
             x:CompileBindings="False"
             FontFamily="{DynamicResource AppleUiFont}"
             Background="{DynamicResource AppleBgBrush}"
             Foreground="{DynamicResource AppleFgBrush}">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Meta+P" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveActiveNoteCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Meta+N" Command="{Binding CreateNewNoteCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <!-- ========================================================================= -->
    <!-- 3-PANE MASTER-DETAIL EDITORIAL WORKSPACE ARCHITECTURE                     -->
    <!-- Col 0: Pane 1 — Left Navigation, Quick Links, Folders/Subfolders & Tags   -->
    <!-- Col 1: Pane 2 — Middle Note Feed Column (Search, Circular +, Note Cards)  -->
    <!-- Col 2: Pane 3 — Right Main Editorial Note Studio & Screens 2–8 (*)        -->
    <!-- Col 3: Collapsible Right Backlinks, Outline & RAG Copilot Drawer (Auto)   -->
    <!-- Row 1: Bottom Telemetry & Word/Backlink Status Bar (26px)                 -->
    <!-- ========================================================================= -->
    <Grid RowDefinitions="*,26" ColumnDefinitions="210,Auto,*,Auto">

      <!-- ===================================================================== -->
      <!-- PANE 1 (COL 0): LEFT NAVIGATION, QUICK LINKS, FOLDERS & TAGS SIDEBAR  -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="0"
              IsVisible="{Binding IsLeftSidebarOpen}"
              Background="{DynamicResource AppleSurfaceBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="10,10">
        <DockPanel LastChildFill="True">

          <!-- Top macOS Traffic Lights + Workspace Header -->
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <!-- macOS Window Controls -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,10,0">
                <Border Width="10" Height="10" CornerRadius="999" Background="#FF5F56" />
                <Border Width="10" Height="10" CornerRadius="999" Background="#FFBD2E" />
                <Border Width="10" Height="10" CornerRadius="999" Background="#27C93F" />
              </StackPanel>

              <!-- Workspace Badge ("R Rhyolite") -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AppleAccentBrush}">
                  <TextBlock Text="R" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Rhyolite" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" />
                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Sync & Collapse Buttons -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Content="↻"
                        Command="{Binding OpenDailyNoteCommand}"
                        Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12"
                        Foreground="{DynamicResource AppleMutedBrush}"
                        ToolTip.Tip="Sync Vault &amp; Open Today's Daily Note" />
                <Button Content="‹"
                        Command="{Binding ToggleLeftSidebarCommand}"
                        Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="14"
                        Foreground="{DynamicResource AppleMutedBrush}"
                        ToolTip.Tip="Collapse Left Sidebar" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Bottom User Profile Footer (Matches Reference Screenshots) -->
          <Border DockPanel.Dock="Bottom"
                  BorderBrush="{DynamicResource AppleBorderSoftBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="4,8,4,2"
                  Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
              <Grid Grid.Column="0" Width="28" Height="28">
                <Border Width="28" Height="28" CornerRadius="999" Background="{DynamicResource AppleSurfaceWarmBrush}" BorderBrush="{DynamicResource AppleBorderBrush}" BorderThickness="1">
                  <TextBlock Text="DB" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="7" Height="7" CornerRadius="999" Background="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>
              <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Dustin Blad" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppleFgBrush}" />
                <TextBlock Text="Personal" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="⌘P"
                      Command="{Binding ToggleCommandPaletteCommand}"
                      Classes="apple-btn-secondary"
                      Padding="6,2" FontSize="10"
                      ToolTip.Tip="Open Command Palette (⌘P)" />
            </Grid>
          </Border>

          <!-- Scrollable Navigation Sections: Quick links, Folders, Tags, Studios -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

              <!-- SECTION 1: QUICK LINKS -->
              <StackPanel Spacing="2">
                <TextBlock Text="Quick links"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppleMutedBrush}"
                           Margin="6,0,0,4" />

                <!-- Active Full-Capsule Selection Pill ("All notes") -->
                <Button Command="{Binding SelectFolderFilterCommand}"
                        CommandParameter="All"
                        Background="{DynamicResource AppleAccentBrush}"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="999"
                        Padding="10,5"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📄" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="All notes" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Clean Unselected Quick Link Rows -->
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Study"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔔" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Reminders" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Studio"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="☑️" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Tasks" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding SetLeftSidebarTabCommand}" CommandParameter="Bookmarks"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="♡" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Favorites" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🖊️" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Highlights" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="DevEx"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="🕒" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Activity" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="999" Background="#EF4444" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Saved search expandable group -->
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Bases"
                        Background="Transparent" BorderThickness="0" Padding="6,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Saved search" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding FilterByObjectTypeCommand}" CommandParameter="Architecture ADR"
                        Background="Transparent" BorderThickness="0" Padding="28,3,10,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Architecture" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="1" Text="6" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>

                <Button Command="{Binding FilterByObjectTypeCommand}" CommandParameter="Project"
                        Background="Transparent" BorderThickness="0" Padding="28,3,10,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Capacities" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="1" Text="4" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>
              </StackPanel>

              <!-- SECTION 2: FOLDERS & NESTED SUBFOLDERS (WITH DIRECT/TOTAL COUNTS) -->
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,0,2,2">
                  <TextBlock Grid.Column="0"
                             Text="Folders"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppleMutedBrush}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="≡"
                          Command="{Binding SelectFolderFilterCommand}" CommandParameter="All"
                          Background="Transparent" BorderThickness="0" Padding="5,1" FontSize="12"
                          Foreground="{DynamicResource AppleMutedBrush}"
                          ToolTip.Tip="Show All Folders" />
                  <Button Grid.Column="2"
                          Content="＋"
                          Command="{Binding ToggleFolderStudioCommand}"
                          Background="Transparent" BorderThickness="0" Padding="5,1" FontSize="12"
                          Foreground="{DynamicResource AppleMutedBrush}"
                          ToolTip.Tip="Open Folder &amp; Emoji Studio" />
                </Grid>

                <!-- Progressive-Disclosure Folder & Emoji Studio Popover Card -->
                <Border IsVisible="{Binding IsFolderStudioOpen}"
                        Background="{DynamicResource AppleSurfaceWarmBrush}"
                        BorderBrush="{DynamicResource AppleAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,7"
                        Margin="2,2,2,4">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="🎨 Folder &amp; Emoji Studio" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="✕" Command="{Binding ToggleFolderStudioCommand}" Background="Transparent" BorderThickness="0" Padding="3,0" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="3">
                      <TextBox Grid.Column="0" Text="{Binding SelectedEmojiInput, Mode=TwoWay}" FontSize="11" Padding="2" HorizontalContentAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding NewFolderPathInput, Mode=TwoWay}" PlaceholderText="Folder/Subfolder..." FontSize="10" Padding="4,2" />
                      <Button Grid.Column="2" Content="＋" Command="{Binding CreateFolderOrSubfolderCommand}" Classes="apple-btn-primary" Padding="6,2" FontSize="10" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="🏛️" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="🏛️" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="💾" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="💾" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="🔌" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="🔌" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="🚀" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="🚀" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="🤝" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="🤝" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="🧠" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="🧠" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                        <Button Content="📅" Command="{Binding AssignEmojiToSelectedFolderCommand}" CommandParameter="📅" Classes="apple-btn-secondary" Padding="3,1" FontSize="10" />
                      </StackPanel>
                    </ScrollViewer>
                  </StackPanel>
                </Border>

                <!-- Hierarchical Folder & Subfolder Tree matching Reference Screenshots (e.g. " Projects 4/4") -->
                <ItemsControl ItemsSource="{Binding VisibleFolderNodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="16,*" Margin="{Binding IndentMargin}" MinHeight="26">
                        <Button Grid.Column="0"
                                Content="{Binding ChevronGlyph}"
                                Command="{Binding $parent[UserControl].DataContext.ToggleFolderExpandedCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                FontSize="10" Foreground="{DynamicResource AppleMutedBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding $parent[UserControl].DataContext.SelectFolderFilterCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="4,3"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding IconEmoji}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding DirectNoteCount}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                              <TextBlock Text="/" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                              <TextBlock Text="{Binding TotalNoteCount}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- SECTION 3: TAGS -->
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto" Margin="6,0,2,2">
                  <TextBlock Grid.Column="0" Text="Tags" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="＋" Command="{Binding TogglePropertiesAccordionCommand}" Background="Transparent" BorderThickness="0" Padding="5,1" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" />
                </Grid>
                <Button Command="{Binding SelectFolderFilterCommand}" CommandParameter="All"
                        Background="Transparent" BorderThickness="0" Padding="10,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                    <TextBlock Grid.Column="0" Text="🏷️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="architecture" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="2" Text="6" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>
                <Button Command="{Binding SelectFolderFilterCommand}" CommandParameter="All"
                        Background="Transparent" BorderThickness="0" Padding="10,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                    <TextBlock Grid.Column="0" Text="🏷️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="sqlite-wal" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="2" Text="3" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>
                <Button Command="{Binding SelectFolderFilterCommand}" CommandParameter="All"
                        Background="Transparent" BorderThickness="0" Padding="10,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                    <TextBlock Grid.Column="0" Text="🏷️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="capacities" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="2" Text="4" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>
              </StackPanel>

              <!-- SECTION 4: TRASH & WORKSPACE STUDIOS -->
              <StackPanel Spacing="2">
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Study"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="🗑️" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Trash" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                    <TextBlock Grid.Column="2" Text="25" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                  </Grid>
                </Button>

                <TextBlock Text="Studios" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleMutedBrush}" Margin="6,6,0,2" />
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Graph" Background="Transparent" BorderThickness="0" Padding="10,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🕸️" FontSize="12" />
                    <TextBlock Text="Knowledge Graph" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas" Background="Transparent" BorderThickness="0" Padding="10,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🎨" FontSize="12" />
                    <TextBlock Text="Spatial Canvas" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Bases" Background="Transparent" BorderThickness="0" Padding="10,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" FontSize="12" />
                    <TextBlock Text="Capacities Studio" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding SwitchScreenCommand}" CommandParameter="Protocol" Background="Transparent" BorderThickness="0" Padding="10,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔌" FontSize="12" />
                    <TextBlock Text="MCP &amp; P2P Mesh" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" />
                  </StackPanel>
                </Button>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===================================================================== -->
      <!-- PANE 2 (COL 1): MIDDLE NOTE FEED COLUMN (SEARCH + CIRCULAR + + CARDS) -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="1"
              Width="285"
              IsVisible="{Binding IsStudioView}"
              Background="{DynamicResource AppleSurfaceWarmBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="12,10">
        <DockPanel LastChildFill="True">

          <!-- Top Pill Search Box + Circular Blue/Accent '+' Button -->
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
              <Border Grid.Column="0"
                      CornerRadius="999"
                      Background="{DynamicResource AppleSurfaceBrush}"
                      BorderBrush="{DynamicResource AppleBorderBrush}"
                      BorderThickness="1"
                      Padding="10,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="🔍" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding SearchFilter, Mode=TwoWay}"
                           PlaceholderText="Search"
                           BorderThickness="0"
                           Background="Transparent"
                           FontSize="12"
                           Padding="0"
                           VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Circular Accent '+' New Note Button -->
              <Button Grid.Column="1"
                      Content="＋"
                      Command="{Binding CreateNewNoteCommand}"
                      Background="{DynamicResource AppleAccentBrush}"
                      Foreground="#FFFFFF"
                      BorderThickness="0"
                      Width="28" Height="28"
                      CornerRadius="999"
                      Padding="0"
                      FontSize="14"
                      FontWeight="Bold"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="Create New Note (⌘N)" />
            </Grid>

            <!-- Feed Header ("📄 All notes ▾") -->
            <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="All notes" Classes="display-heading" FontSize="16" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" />
                <TextBlock Text="▾" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding ActiveFolderFilter}"
                         FontSize="10.5"
                         Foreground="{DynamicResource AppleMutedBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- Scrollable Feed of Note Cards (Dot + Title + Snippet + Reminder/Type Pill) -->
          <ListBox ItemsSource="{Binding VaultNotes}"
                   SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                   SelectionChanged="OnVaultNoteSelectionChanged"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource AppleSurfaceBrush}"
                        BorderBrush="{DynamicResource AppleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,9"
                        Margin="0,3">
                  <StackPanel Spacing="5">
                    <!-- Row 1: Colored Status Circle Dot + Bold Note Title -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" VerticalAlignment="Center">
                      <Border Grid.Column="0"
                              Width="9" Height="9"
                              CornerRadius="999"
                              Background="{Binding CoverColorHex}"
                              VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 Classes="display-heading"
                                 FontSize="13"
                                 Foreground="{DynamicResource AppleFgBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding ObjectIconEmoji}"
                                 FontSize="11"
                                 Foreground="{DynamicResource AppleMutedBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 2: Date + 1-Line Body Snippet -->
                    <TextBlock Text="{Binding BodyWithoutFrontmatter}"
                               FontSize="11.5"
                               Foreground="{DynamicResource AppleMutedBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Row 3: Tinted Reminder / Timestamp / Object Type Pill Badge -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <Border CornerRadius="999"
                              Background="{DynamicResource AppleCalloutBgBrush}"
                              Padding="8,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="🔔" FontSize="9.5" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ObjectType, StringFormat='04 NOV 15:00 · {0}'}"
                                     FontSize="9.5"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource AppleLinkBrush}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===================================================================== -->
      <!-- PANE 3 (COL 2): RIGHT MAIN EDITORIAL NOTE STUDIO & SCREENS 2–8        -->
      <!-- ===================================================================== -->
      <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="42,*">

        <!-- TOP MINIMAL HEADER BAR (FOLDER BREADCRUMB + ADD TAGS + RIGHT ICONS) -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppleBgBrush}"
                BorderBrush="{DynamicResource AppleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">

            <!-- Left: Active Folder Dropdown + Add Tags (Matches Reference Screenshots) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Command="{Binding ToggleFolderStudioCommand}"
                      Background="Transparent" BorderThickness="0" Padding="4,3">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveNoteFolderBreadcrumb}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppleFgBrush}" />
                  <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource AppleBorderBrush}" VerticalAlignment="Center" />

              <Button Command="{Binding TogglePropertiesAccordionCommand}"
                      Background="Transparent" BorderThickness="0" Padding="4,3">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="🏷️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" />
                  <TextBlock Text="Add tags" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Center: Compact Workspace Screen Pills + Design System Switcher -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Button Content="📄 Note" Command="{Binding SwitchScreenCommand}" CommandParameter="Studio" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="🕸️ Graph" Command="{Binding SwitchScreenCommand}" CommandParameter="Graph" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="🎨 Canvas" Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="✨ Studio" Command="{Binding SwitchScreenCommand}" CommandParameter="Bases" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="🧠 FSRS" Command="{Binding SwitchScreenCommand}" CommandParameter="Study" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="🔌 MCP" Command="{Binding SwitchScreenCommand}" CommandParameter="Protocol" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="🛡️ PR" Command="{Binding SwitchScreenCommand}" CommandParameter="DevEx" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                <Button Content="📱 iOS" Command="{Binding SwitchScreenCommand}" CommandParameter="Mobile" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
              </StackPanel>
            </ScrollViewer>

            <!-- Right: Design System Selector + Minimal Action Icons (📎 ☑️ 🔔 🔗 ⤢ •••) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="◀" Command="{Binding PreviousDesignSystemCommand}" Background="Transparent" BorderThickness="0" Padding="4,2" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
              <ComboBox ItemsSource="{Binding DesignSystems}"
                        SelectedItem="{Binding SelectedDesignSystem, Mode=TwoWay}"
                        Width="128" FontSize="10.5" Padding="6,2" />
              <Button Content="▶" Command="{Binding NextDesignSystemCommand}" Background="Transparent" BorderThickness="0" Padding="4,2" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
              <Button Content="🌗" Command="{Binding ToggleAppleThemeCommand}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" ToolTip.Tip="Toggle Light / Dark Theme" />

              <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource AppleBorderBrush}" VerticalAlignment="Center" Margin="2,0" />

              <Button Content="📎" Command="{Binding SaveActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" ToolTip.Tip="Attach / Save to SQLite WAL" />
              <Button Content="☑️" Command="{Binding TogglePropertiesAccordionCommand}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" ToolTip.Tip="Toggle Properties &amp; Tasks" />
              <Button Content="🔔" Command="{Binding SwitchScreenCommand}" CommandParameter="Study" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" ToolTip.Tip="FSRS Reminders" />
              <Button Content="🔗" Command="{Binding ToggleRightSidebarCommand}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" ToolTip.Tip="Toggle Backlinks &amp; Outline Drawer" />
              <Button Content="⤢" Command="{Binding ToggleLeftSidebarCommand}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" ToolTip.Tip="Focus Mode" />
              <Button Content="•••" Command="{Binding ToggleNoteMenuCommand}" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppleFgBrush}" ToolTip.Tip="Note Options Menu" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- MAIN WORKSPACE BODY (SCREENS 1 THROUGH 8 + FLOATING ••• MENU)       -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1">

          <!-- SCREEN 1: EDITORIAL NOTE STUDIO (HERO BANNER + ● TITLE + GOOGLE DRIVE/WAL CARD + BOTTOM SLASH BAR) -->
          <Grid IsVisible="{Binding IsStudioView}" RowDefinitions="*,Auto">

            <ScrollViewer Grid.Row="0" Padding="28,16,28,10">
              <StackPanel Spacing="14">

                <!-- Hero Visual Artwork Banner + Floating '✨ Templates' Pill Button (Matches Screenshots 1–3) -->
                <Border Height="104"
                        CornerRadius="10"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource AppleBorderBrush}"
                        BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#2E1065" Offset="0.0" />
                      <GradientStop Color="#9D174D" Offset="0.38" />
                      <GradientStop Color="#D97706" Offset="0.74" />
                      <GradientStop Color="#1E3A8A" Offset="1.0" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <!-- Decorative Warm Abstract Geometric Accents -->
                    <Border Width="180" Height="180" CornerRadius="999" Background="#33F59E0B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,-40,0,0" />
                    <Border Width="220" Height="220" CornerRadius="999" Background="#28EC4899" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,20,0,0" />
                    <Border Width="140" Height="140" CornerRadius="999" Background="#3338BDF8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,90,-30" />

                    <!-- Subtle Editorial Banner Caption (Bottom-Left) -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,12" Spacing="1">
                      <TextBlock Text="{Binding SelectedNote.CollectionName, StringFormat='COLLECTION · {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#CCF8FAFC" />
                      <TextBlock Text="{Binding ActiveDesignSubtitleText}" FontSize="11" Foreground="#F8FAFC" />
                    </StackPanel>

                    <!-- Floating Top-Right '✨ Templates' Pill Button (Matches Screenshot 3) -->
                    <Button Command="{Binding CreateTypedObjectCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,14,0"
                            Background="#CC18181B"
                            Foreground="#FFFFFF"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="12,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✨" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Text="Templates" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>

                <!-- Large Editorial Title Row: Colored Circle Dot + 26px Bold Title + Mode Pills -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                  <Border Grid.Column="0"
                          Width="11" Height="11"
                          CornerRadius="999"
                          Background="#F59E0B"
                          VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding EditableNoteTitle, Mode=TwoWay}"
                           Classes="display-heading"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppleFgBrush}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="0"
                           VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="✏️ Source" Command="{Binding SetEditorModeCommand}" CommandParameter="Source" Classes="apple-btn-secondary" Padding="7,3" FontSize="10.5" />
                    <Button Content="◫ Split" Command="{Binding SetEditorModeCommand}" CommandParameter="Split" Classes="apple-btn-primary" Padding="7,3" FontSize="10.5" />
                    <Button Content="📖 Reading" Command="{Binding SetEditorModeCommand}" CommandParameter="Reading" Classes="apple-btn-secondary" Padding="7,3" FontSize="10.5" />
                  </StackPanel>
                </Grid>

                <!-- Compact Properties & Tags Pill Strip -->
                <WrapPanel IsVisible="{Binding IsPropertiesExpanded}" Orientation="Horizontal">
                  <ItemsControl ItemsSource="{Binding ActiveProperties}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-pill"
                                Background="{DynamicResource AppleSurfaceBrush}"
                                BorderBrush="{DynamicResource AppleBorderSoftBrush}"
                                BorderThickness="1"
                                Margin="0,2,6,2" Padding="8,2">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Key}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
                            <TextBlock Text=":" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
                            <TextBlock Text="{Binding Value}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppleFgBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{Binding ActiveTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-pill"
                                Background="{DynamicResource AppleCalloutBgBrush}"
                                Margin="0,2,6,2" Padding="8,2">
                          <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>

                <!-- Clean Editorial Body & Live WikiLink / Callout Reading Surface -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="20" MaxHeight="285">
                  <!-- Left: Clean Editorial Markdown Canvas -->
                  <Border Grid.Column="0"
                          Grid.ColumnSpan="{Binding SourceEditorColumnSpan}"
                          IsVisible="{Binding IsSourceEditorVisible}"
                          Background="Transparent"
                          Padding="0">
                    <TextBox Text="{Binding EditorMarkdownText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="13"
                             LineHeight="20"
                             Foreground="{DynamicResource AppleFg2Brush}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0" />
                  </Border>

                  <!-- Right: Formatted Editorial Reading Preview + Clickable [[WikiLinks]] + Callouts -->
                  <Border Grid.Column="{Binding ReadingPreviewGridColumn}"
                          Grid.ColumnSpan="{Binding ReadingPreviewColumnSpan}"
                          IsVisible="{Binding IsReadingPreviewVisible}"
                          Background="{DynamicResource AppleSurfaceBrush}"
                          BorderBrush="{DynamicResource AppleBorderSoftBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="14,10">
                    <StackPanel Spacing="8">
                      <!-- Clickable Outgoing [[WikiLinks]] -->
                      <ItemsControl ItemsSource="{Binding ActiveOutgoingLinks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding $parent[UserControl].DataContext.OpenWikiLinkCommand}"
                                    CommandParameter="{Binding TargetTitle}"
                                    Classes="apple-btn-secondary"
                                    Padding="7,2" Margin="0,0,5,4" FontSize="10.5">
                              <TextBlock Text="{Binding TargetTitle, StringFormat='↗ [[{0}]]'}" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="SemiBold" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Rendered Callout Cards -->
                      <ItemsControl ItemsSource="{Binding ActiveCallouts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource AppleCalloutBgBrush}"
                                    BorderBrush="{DynamicResource AppleLinkBrush}"
                                    BorderThickness="3,1,1,1"
                                    CornerRadius="6"
                                    Padding="10,7" Margin="0,2">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="11.5" Foreground="{DynamicResource AppleLinkBrush}" />
                                <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="{Binding ReadingPreviewBodyText}"
                                 FontSize="12.5"
                                 LineHeight="19"
                                 MaxLines="5"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource AppleFg2Brush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Embedded Bordered Cloud / SQLite Sidecar Card (Mirrors 'Google drive / Podcast draft.mp3' Card in Screenshots 1 & 3) -->
                <Border Background="{DynamicResource AppleSurfaceBrush}"
                        BorderBrush="{DynamicResource AppleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,4,0,4">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🔺" FontSize="11.5" VerticalAlignment="Center" />
                      <TextBlock Text="SQLite WAL Sidecar &amp; Vault Drive" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="18" Height="18" CornerRadius="4" Background="#EF4444">
                        <TextBlock Text="⚡" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding SelectedNote.RelativePath, FallbackValue='01 — Architecture/Storage Architecture.md'}"
                                 Classes="display-heading"
                                 FontSize="13.5"
                                 Foreground="{DynamicResource AppleFgBrush}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Last modified by Dustin Blad 1 minute ago · Atomic .md flush in 0.14 ms"
                               FontSize="11.5"
                               Foreground="{DynamicResource AppleMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                      <TextBlock Text="🔗" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="rhyolite.local/vault/cache.db" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>

            <!-- Bottom Slash-Command Formatting Bar ('Type "/" or add' + Icons — Matches Screenshots 1 & 3) -->
            <Border Grid.Row="1"
                    Padding="28,8,28,12"
                    Background="{DynamicResource AppleBgBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <!-- Left Slash-Command & Rich Insert Toolbar -->
                <Border Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AppleSurfaceBrush}"
                        BorderBrush="{DynamicResource AppleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,5">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Type &quot;/&quot; or add" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="☑️" Command="{Binding TogglePropertiesAccordionCommand}" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Insert Task Checklist" />
                    <Button Content="☰" Command="{Binding SetEditorModeCommand}" CommandParameter="Split" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Bullet List" />
                    <Button Content="🔢" Command="{Binding SetEditorModeCommand}" CommandParameter="Source" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Numbered List" />
                    <Button Content="⊞" Command="{Binding SwitchScreenCommand}" CommandParameter="Bases" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Insert Table / Object" />
                    <Button Content="🖼️" Command="{Binding SwitchScreenCommand}" CommandParameter="Canvas" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Insert Spatial Canvas" />
                    <Button Content="📎" Command="{Binding SaveActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="3,1" FontSize="12" Foreground="{DynamicResource AppleFg2Brush}" ToolTip.Tip="Attach File" />
                    <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource AppleBorderBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="⌄" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Bottom-Right Floating Keyboard & Emoji Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="⌨️" Command="{Binding ToggleCommandPaletteCommand}" Classes="apple-btn-secondary" Padding="7,4" FontSize="11.5" ToolTip.Tip="Command Palette (⌘P)" />
                  <Button Content="😊" Command="{Binding ToggleFolderStudioCommand}" Classes="apple-btn-secondary" Padding="7,4" FontSize="11.5" ToolTip.Tip="Emoji &amp; Icon Picker" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- FLOATING '•••' CONTEXT MENU POPOVER (MIRRORS SCREENSHOT 1) -->
          <Border IsVisible="{Binding IsNoteMenuOpen}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Width="225"
                  Margin="0,6,14,0"
                  Background="{DynamicResource AppleSurfaceWarmBrush}"
                  BorderBrush="{DynamicResource AppleBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="8,8">
            <StackPanel Spacing="2">
              <Button Command="{Binding TogglePinActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="♡" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Add to favorites" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding TogglePinActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="📌" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Pin note" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                <TextBlock Grid.Column="0" Text="🎨" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="25" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Set color" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Border Width="10" Height="10" CornerRadius="999" Background="#EF4444" />
                  <Border Width="10" Height="10" CornerRadius="999" Background="#F59E0B" />
                  <Border Width="10" Height="10" CornerRadius="999" Background="#10B981" />
                  <Border Width="10" Height="10" CornerRadius="999" Background="#3B82F6" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                <TextBlock Grid.Column="0" Text="⛶" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" Width="25" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Focus mode" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="2" Width="26" Height="14" CornerRadius="999" Background="{DynamicResource AppleBorderBrush}" Padding="2">
                  <Border Width="10" Height="10" CornerRadius="999" Background="#FFFFFF" HorizontalAlignment="Left" />
                </Border>
              </Grid>
              <Button Command="{Binding NextDesignSystemCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="⚙️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="25" />
                  <TextBlock Grid.Column="1" Text="Appearance" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                  <TextBlock Grid.Column="2" Text="›" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" />
                </Grid>
              </Button>

              <Border Height="1" Background="{DynamicResource AppleBorderBrush}" Margin="4,3" />

              <Button Command="{Binding ToggleCommandPaletteCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="🔍" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Find in note" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding MoveActiveNoteToSelectedFolderCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="📁" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Move to" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding SaveActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="📋" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Copy to" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleRightSidebarCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="ℹ️" FontSize="11.5" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Note info" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>

              <Border Height="1" Background="{DynamicResource AppleBorderBrush}" Margin="4,3" />

              <Button Command="{Binding RestorePreviousSnapshotCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="↩" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Undo" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding SaveMilestoneSnapshotCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="↪" FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" Width="16" />
                  <TextBlock Text="Redo" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                </StackPanel>
              </Button>

              <Border Height="1" Background="{DynamicResource AppleBorderBrush}" Margin="4,3" />

              <Button Command="{Binding DeleteActiveNoteCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="🗑️" FontSize="11.5" Foreground="#EF4444" Width="16" />
                  <TextBlock Text="Delete" FontSize="12" Foreground="#EF4444" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- SCREEN 2: OBSIDIAN FORCE-DIRECTED KNOWLEDGE GRAPH -->
          <Grid IsVisible="{Binding IsGraphView}" ColumnDefinitions="*,270" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card" ClipToBounds="True" Padding="0">
              <controls:KnowledgeGraphControl x:Name="GraphCanvas"
                                              Nodes="{Binding GraphNodes}"
                                              Edges="{Binding GraphEdges}"
                                              IsDarkTheme="{Binding IsDarkTheme}"
                                              DesignPresetId="{Binding SelectedDesignSystem.Id}" />
            </Border>
            <Border Grid.Column="1" Classes="apple-card">
              <StackPanel Spacing="10">
                <TextBlock Text="🕸️ Graph Topology" Classes="display-heading" FontSize="17" Foreground="{DynamicResource AppleFgBrush}" />
                <TextBlock Text="{Binding SelectedGraphNodeInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                <Button Content="📄 Open Selected Note in Studio" Command="{Binding OpenSelectedGraphNoteCommand}" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                <Border Classes="apple-surface-card" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="PRIMARY HUB (PAGERANK)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                    <TextBlock Text="{Binding TopologyHubLabel}" Classes="display-heading" FontSize="14" Foreground="{DynamicResource AppleFgBrush}" />
                    <TextBlock Text="{Binding TopologyClusteringLabel}" FontSize="11" Foreground="{DynamicResource AppleSuccessBrush}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Repulsion Force" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" />
                <Slider Minimum="60" Maximum="300" Value="{Binding GraphRepulsion}" />
                <TextBlock Text="Ideal Link Distance" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" />
                <Slider Minimum="50" Maximum="200" Value="{Binding GraphLinkDistance}" />
                <Button Content="⟳ Re-stabilize Force Graph" Command="{Binding RecenterGraphCommand}" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- SCREEN 3: OBSIDIAN SPATIAL INFINITE .CANVAS BOARD -->
          <Grid IsVisible="{Binding IsCanvasView}" RowDefinitions="Auto,*" Margin="14,10" RowSpacing="10">
            <Border Grid.Row="0" Classes="apple-surface-card" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="🎨 Obsidian Spatial Canvas (.canvas JSON Spec)" Classes="display-heading" FontSize="15" />
                  <TextBlock Text="Drag cards on the infinite grid · Edit selected card title &amp; body below" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding SelectedCanvasCardTitle, Mode=TwoWay}" PlaceholderText="Card title" Width="150" FontSize="11" />
                <TextBox Grid.Column="2" Text="{Binding SelectedCanvasCardBody, Mode=TwoWay}" PlaceholderText="Card markdown body" Width="180" FontSize="11" />
                <Button Grid.Column="3" Content="✓ Update Card" Command="{Binding UpdateSelectedCanvasCardCommand}" Classes="apple-btn-secondary" />
                <Button Grid.Column="4" Content="＋ Add Card" Command="{Binding AddCanvasCardCommand}" Classes="apple-btn-primary" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="apple-card" ClipToBounds="True" Padding="0">
              <controls:SpatialCanvasControl x:Name="CanvasBoard"
                                             Document="{Binding CanvasDoc}"
                                             IsDarkTheme="{Binding IsDarkTheme}"
                                             DesignPresetId="{Binding SelectedDesignSystem.Id}"
                                             SelectedCardId="{Binding SelectedCanvasCardId}" />
            </Border>
          </Grid>

          <!-- SCREEN 4: CAPACITIES OBJECT STUDIO & OBSIDIAN BASES (GALLERY / WALL / TABLE / CALENDAR) -->
          <Grid IsVisible="{Binding IsBasesView}" RowDefinitions="Auto,Auto,*" Margin="14,10" RowSpacing="8">
            <Border Grid.Row="0" Classes="apple-surface-card" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="✨ Capacities Object Studio &amp; Obsidian Bases" Classes="display-heading" FontSize="16" />
                  <TextBlock Text="Typed objects, custom schemas, collections, and hierarchical folder/subfolder projections" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="🖼️ Gallery View" Command="{Binding ShowBasesGalleryCommand}" Classes="apple-btn-primary" Padding="10,5" FontSize="11.5" />
                <Button Grid.Column="2" Content="🧱 Wall / Kanban" Command="{Binding ShowBasesKanbanCommand}" Classes="apple-btn-secondary" Padding="10,5" FontSize="11.5" />
                <Button Grid.Column="3" Content="📋 Bases Table" Command="{Binding ShowBasesTableCommand}" Classes="apple-btn-secondary" Padding="10,5" FontSize="11.5" />
                <Button Grid.Column="4" Content="📅 Calendar Stream" Command="{Binding ShowBasesCalendarCommand}" Classes="apple-btn-secondary" Padding="10,5" FontSize="11.5" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="apple-card" Padding="12,8">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Button Content="✨ All Objects" Command="{Binding FilterByObjectTypeCommand}" CommandParameter="All" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
                      <ItemsControl ItemsSource="{Binding ObjectTypeSchemas}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding $parent[UserControl].DataContext.FilterByObjectTypeCommand}"
                                    CommandParameter="{Binding SingularName}"
                                    Classes="apple-btn-secondary" Padding="8,3" FontSize="11">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding IconEmoji}" />
                                <TextBlock Text="{Binding PluralName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ObjectCount, StringFormat='({0})'}" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="Bold" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBox Text="{Binding NewTypedObjectTitleInput, Mode=TwoWay}" PlaceholderText="New object title..." Width="135" FontSize="11" Padding="6,3" />
                    <Button Content="＋ Create Object" Command="{Binding CreateTypedObjectCommand}" Classes="apple-btn-primary" Padding="8,3" FontSize="11" />
                    <TextBox Text="{Binding NewObjectTypeEmojiInput, Mode=TwoWay}" Width="32" FontSize="11" Padding="4,3" HorizontalContentAlignment="Center" />
                    <TextBox Text="{Binding NewObjectTypeNameInput, Mode=TwoWay}" PlaceholderText="Custom type..." Width="95" FontSize="11" Padding="6,3" />
                    <Button Content="＋ Schema" Command="{Binding CreateCustomObjectTypeCommand}" Classes="apple-btn-secondary" Padding="7,3" FontSize="11" />
                  </StackPanel>
                </Grid>

                <!-- Collections Filter Bar -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="COLLECTIONS:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="⭐ All Collections" Command="{Binding SelectCollectionFilterCommand}" CommandParameter="All" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                    <ItemsControl ItemsSource="{Binding Collections}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding $parent[UserControl].DataContext.SelectCollectionFilterCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding IconEmoji}" />
                              <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                              <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" Foreground="{DynamicResource AppleMutedBrush}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <!-- Visual Subfolder Cards Strip -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="FOLDERS &amp; SUBFOLDERS:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="🗂️ All Folders" Command="{Binding SelectFolderFilterCommand}" CommandParameter="All" Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5" />
                    <ItemsControl ItemsSource="{Binding VisibleFolderNodes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding $parent[UserControl].DataContext.SelectFolderFilterCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="apple-btn-secondary" Padding="7,2" FontSize="10.5">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding IconEmoji}" />
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding TotalNoteCount, StringFormat='· {0}'}" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="Bold" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <!-- MODE 1: CAPACITIES VISUAL GALLERY VIEW -->
            <ScrollViewer Grid.Row="2" IsVisible="{Binding IsBasesGalleryMode}">
              <ItemsControl ItemsSource="{Binding DatabaseRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="apple-card" Margin="5" Padding="12,10">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                          <Border Grid.Column="0" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding ObjectIconEmoji}" FontSize="11.5" />
                              <TextBlock Text="{Binding ObjectType}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="2" Classes="apple-pill" Background="{DynamicResource AppleSurfaceWarmBrush}" Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <TextBlock Text="{Binding FolderIconEmoji}" FontSize="10.5" />
                              <TextBlock Text="{Binding Folder}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                            </StackPanel>
                          </Border>
                        </Grid>

                        <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="14.5" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummarySnippet}" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" MaxLines="3" />

                        <WrapPanel Orientation="Horizontal">
                          <Border Classes="apple-pill" Background="{DynamicResource AppleSurfaceBrush}" Margin="0,2,4,2" Padding="6,2">
                            <TextBlock Text="{Binding CollectionName, StringFormat='⭐ {0}'}" FontSize="10" Foreground="{DynamicResource AppleFg2Brush}" />
                          </Border>
                          <Border Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" Margin="0,2,4,2" Padding="6,2">
                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                          </Border>
                          <Border Classes="apple-pill" Background="{DynamicResource AppleSurfaceBrush}" Margin="0,2,4,2" Padding="6,2">
                            <TextBlock Text="{Binding DateBadge, StringFormat='📅 {0}'}" FontSize="10" Foreground="{DynamicResource AppleMetaBrush}" />
                          </Border>
                        </WrapPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                          <TextBlock Grid.Column="0" Text="{Binding WordCount, StringFormat='{}{0} words'}" FontSize="10" Foreground="{DynamicResource AppleMetaBrush}" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="⟳ Status" Command="{Binding $parent[UserControl].DataContext.CycleRowStatusCommand}" CommandParameter="{Binding}" Classes="apple-btn-secondary" Padding="7,3" FontSize="10.5" />
                          <Button Grid.Column="2" Content="📄 Open Object" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="8,3" FontSize="10.5" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- MODE 2: CAPACITIES WALL / KANBAN BOARD -->
            <ItemsControl Grid.Row="2" IsVisible="{Binding IsBasesKanbanMode}" ItemsSource="{Binding KanbanColumns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="apple-surface-card" Margin="5" Padding="10">
                    <ScrollViewer>
                      <StackPanel Spacing="7">
                        <TextBlock Text="{Binding ColumnName}" Classes="display-heading" FontSize="14" Foreground="{DynamicResource AppleFgBrush}" />
                        <ItemsControl ItemsSource="{Binding Cards}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="apple-card" Margin="0,3" Padding="10,8">
                                <StackPanel Spacing="5">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding ObjectIconEmoji}" FontSize="12" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ObjectType}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding FolderIconEmoji}" FontSize="11" />
                                  </Grid>
                                  <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Folder}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="📄 Open" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="7,3" FontSize="10" />
                                    <Button Content="⟳ Status" Command="{Binding $parent[UserControl].DataContext.CycleRowStatusCommand}" CommandParameter="{Binding}" Classes="apple-btn-secondary" Padding="7,3" FontSize="10" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- MODE 3: OBSIDIAN BASES RELATIONAL TABLE VIEW -->
            <Border Grid.Row="2" IsVisible="{Binding IsBasesTableMode}" Classes="apple-card">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding DatabaseRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10,7" BorderBrush="{DynamicResource AppleBorderSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="1.9*,1.1*,1.3*,1.1*,0.8*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ObjectIconEmoji}" FontSize="13" />
                            <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="12.5" Foreground="{DynamicResource AppleFgBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ObjectType}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                          </Border>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FolderIconEmoji}" FontSize="11.5" />
                            <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding CollectionName}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" VerticalAlignment="Center" />
                          <Button Grid.Column="5" Content="⟳ Status" Command="{Binding $parent[UserControl].DataContext.CycleRowStatusCommand}" CommandParameter="{Binding}" Classes="apple-btn-secondary" Padding="8,3" FontSize="10.5" />
                          <Button Grid.Column="6" Content="📄 Open" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="8,3" FontSize="10.5" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <!-- MODE 4: CAPACITIES DAILY CALENDAR & TIMELINE STREAM -->
            <Border Grid.Row="2" IsVisible="{Binding IsBasesCalendarMode}" Classes="apple-card">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CalendarEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="apple-surface-card" Margin="0,3" Padding="12,8">
                        <Grid ColumnDefinitions="115,Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                          <Border Grid.Column="0" Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" Padding="8,4">
                            <StackPanel>
                              <TextBlock Text="{Binding DateIso}" Classes="mono-code" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                              <TextBlock Text="{Binding DayOfWeekLabel}" FontSize="9.5" Foreground="{DynamicResource AppleMutedBrush}" />
                            </StackPanel>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding ObjectIconEmoji}" FontSize="18" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="13.5" Foreground="{DynamicResource AppleFgBrush}" />
                              <Border Classes="apple-pill" Background="{DynamicResource AppleBgBrush}" Padding="6,1">
                                <TextBlock Text="{Binding ObjectType}" FontSize="9.5" Foreground="{DynamicResource AppleLinkBrush}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FolderIconEmoji}" FontSize="11.5" />
                            <TextBlock Text="{Binding FolderPath}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
                          </StackPanel>
                          <Button Grid.Column="4" Content="📄 Open" Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}" CommandParameter="{Binding NoteRelativePath}" Classes="apple-btn-primary" Padding="8,4" FontSize="11" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- SCREEN 5: FSRS v4 SPACED REPETITION & SNAPSHOT TIME-MACHINE -->
          <Grid IsVisible="{Binding IsStudyView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <StackPanel Spacing="12">
                <Border Classes="apple-pill" Background="{DynamicResource AppleCalloutBgBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="FSRS v4 Spaced Repetition Memory Scheduler" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                </Border>
                <TextBlock Text="🧠 Active Recall Flashcard Deck" Classes="display-heading" FontSize="19" />
                <Border Classes="apple-surface-card">
                  <StackPanel Spacing="10">
                    <TextBlock Text="QUESTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                    <TextBlock Text="{Binding FlashcardQuestion}" Classes="display-heading" FontSize="16" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                    <Button Content="👁️ Flip / Hide-Reveal Answer" Command="{Binding ToggleFlashcardAnswerCommand}" Classes="apple-btn-secondary" HorizontalAlignment="Left" />
                    <StackPanel IsVisible="{Binding IsFlashcardAnswerRevealed}" Spacing="4">
                      <TextBlock Text="ANSWER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                      <TextBlock Text="{Binding FlashcardAnswer}" FontSize="13.5" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding FlashcardMeta}" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" Content="1 · Again" Command="{Binding RateFlashcardCommand}" CommandParameter="Again" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="2 · Hard" Command="{Binding RateFlashcardCommand}" CommandParameter="Hard" Classes="apple-btn-secondary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="2" Content="3 · Good" Command="{Binding RateFlashcardCommand}" CommandParameter="Good" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="3" Content="4 · Easy" Command="{Binding RateFlashcardCommand}" CommandParameter="Easy" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                    <TextBlock Grid.Column="0" Text="⏱️ Snapshot Time-Machine" Classes="display-heading" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="📸 Milestone" Command="{Binding SaveMilestoneSnapshotCommand}" Classes="apple-btn-secondary" Padding="8,4" FontSize="11" />
                    <Button Grid.Column="2" Content="⏪ Restore" Command="{Binding RestorePreviousSnapshotCommand}" Classes="apple-btn-primary" Padding="8,4" FontSize="11" />
                  </Grid>
                  <TextBlock Text="LCS line-by-line delta stored in .rhyolite/cache.db" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding ActiveDiffLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="7,3" Margin="0,1" CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}" Background="{DynamicResource AppleSurfaceBrush}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Prefix}" Classes="mono-code" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" />
                            <TextBlock Text="{Binding Text}" Classes="mono-code" FontSize="11" Foreground="{DynamicResource AppleFgBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <!-- SCREEN 6: MCP JSON-RPC 2.0 + GRAPHQL + P2P MESH & WORKSPACE CONNECTORS -->
          <Grid IsVisible="{Binding IsProtocolView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <TextBlock Text="⚡ MCP JSON-RPC 2.0 &amp; GraphQL Live Executor" Classes="display-heading" FontSize="18" />
                  <TextBox Text="{Binding ProtocolConsoleInput}" Classes="mono-code" AcceptsReturn="True" TextWrapping="Wrap" Height="75" FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="▶ Run MCP JSON-RPC 2.0" Command="{Binding ExecuteMcpRpcCommand}" Classes="apple-btn-primary" />
                    <Button Content="▶ Run GraphQL Query" Command="{Binding ExecuteGraphQlSampleCommand}" Classes="apple-btn-secondary" />
                  </StackPanel>
                </StackPanel>
                <TextBox Text="{Binding ProtocolConsoleOutput}" Classes="mono-code" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11.5" Background="{DynamicResource AppleSurfaceBrush}" />
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Classes="apple-card">
              <StackPanel Spacing="10">
                <TextBlock Text="🔄 Bladbase &amp; Docmost Connectors" Classes="display-heading" FontSize="17" />
                <TextBlock Text="Bi-directional HLC CRDT sync with Bladbase workspaces and Docmost wiki spaces." FontSize="12" Foreground="{DynamicResource AppleMutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="🔄 Sync Bladbase" Command="{Binding SyncBladbaseCommand}" Classes="apple-btn-primary" />
                  <Button Content="🔄 Sync Docmost" Command="{Binding SyncDocmostCommand}" Classes="apple-btn-secondary" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- SCREEN 7: ENTERPRISE GITHUB PR STUDIO & 1PASSWORD / KEEPASSXC DEVEX -->
          <Grid IsVisible="{Binding IsDevExView}" ColumnDefinitions="1.15*,1*" Margin="14,10" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="🛡️ GitHub PR Review &amp; Secret Redaction Studio" Classes="display-heading" FontSize="18" />
                  <Grid ColumnDefinitions="*,85,Auto,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding GitHubRepoInput, Mode=TwoWay}" PlaceholderText="owner/repo" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding GitHubPrNumberInput, Mode=TwoWay}" PlaceholderText="PR #" FontSize="12" />
                    <Button Grid.Column="2" Content="🔄 Fetch PR" Command="{Binding RefreshGitHubPrPreviewCommand}" Classes="apple-btn-secondary" />
                    <Button Grid.Column="3" Content="📥 Pull to Vault" Command="{Binding ImportGitHubPrToVaultCommand}" Classes="apple-btn-primary" />
                  </Grid>
                  <TextBlock Text="{Binding GitHubPrHeaderText}" Classes="display-heading" FontSize="13" Foreground="{DynamicResource AppleFgBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding GitHubPrMetaText}" FontSize="11" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding ActivePrComments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="apple-surface-card" Margin="0,3" Padding="10,7">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Author, StringFormat='@{0}'}" Classes="display-heading" FontSize="12" Foreground="{DynamicResource AppleFgBrush}" />
                            <TextBlock Text="{Binding FilePath}" Classes="mono-code" FontSize="10.5" Foreground="{DynamicResource AppleLinkBrush}" />
                            <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Column="1" Classes="apple-card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="🔐 1Password CLI (op) &amp; KeePassXC Guardrails" Classes="display-heading" FontSize="16" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="🔑 1Password Scan" Command="{Binding RunOnePasswordScanCommand}" Classes="apple-btn-primary" Margin="0,0,6,6" />
                    <Button Content="🛡️ KeePassXC Scan" Command="{Binding RunKeePassScanCommand}" Classes="apple-btn-secondary" Margin="0,0,6,6" />
                    <Button Content="⚠️ Override Guardrail" Command="{Binding OverrideRunbookGuardrailCommand}" Classes="apple-btn-secondary" Margin="0,0,6,6" />
                  </WrapPanel>
                </StackPanel>
                <TextBox Text="{Binding DevExTerminalOutput}" Classes="mono-code" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11.5" Background="{DynamicResource AppleSurfaceBrush}" />
              </DockPanel>
            </Border>
          </Grid>

          <!-- SCREEN 8: MOBILE COMPANION SHELL -->
          <Grid IsVisible="{Binding IsMobileView}" ColumnDefinitions="*,410,*" Margin="14,10">
            <Border Grid.Column="1" Classes="apple-card" Padding="18">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <TextBlock Text="📱 Rhyolite Mobile (iOS &amp; Android)" Classes="display-heading" FontSize="18" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding MobileQuickCaptureText, Mode=TwoWay}" PlaceholderText="Quick thought or #tag..." />
                    <Button Grid.Column="1" Content="Capture" Command="{Binding MobileQuickCaptureCommand}" Classes="apple-btn-primary" />
                  </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding VaultNotes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         SelectionChanged="OnVaultNoteSelectionChanged"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="apple-surface-card" Margin="0,3" Padding="10,7">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" Classes="display-heading" FontSize="13" />
                          <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===================================================================== -->
      <!-- COL 3: COLLAPSIBLE RIGHT SIDEBAR (BACKLINKS / OUTLINE / AI)           -->
      <!-- ===================================================================== -->
      <Border Grid.Row="0" Grid.Column="3"
              Width="265"
              IsVisible="{Binding IsRightSidebarOpen}"
              Background="{DynamicResource AppleSurfaceBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="1,0,0,0"
              Padding="10,8">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="🔗 BACKLINKS · 📑 OUTLINE · ✦ AI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />

            <!-- Document Outline (TOC) -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="4">
                <TextBlock Text="📑 DOCUMENT OUTLINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveHeadings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.JumpToHeadingCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4,2"
                              CornerRadius="{DynamicResource AppleSecondaryBtnCornerRadius}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="{Binding Text, StringFormat='§ {0}'}" FontSize="11.5" Foreground="{DynamicResource AppleFg2Brush}" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Linked Mentions (Backlinks) -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="5">
                <TextBlock Text="🔗 LINKED MENTIONS (BACKLINKS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveBacklinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}"
                              CommandParameter="{Binding SourceNotePath}"
                              Classes="apple-btn-secondary"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,5" Margin="0,2">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SourceNotePath, StringFormat='↩ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ContextSnippet}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Semantically Related Notes -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="5">
                <TextBlock Text="🧠 SEMANTICALLY RELATED NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleMetaBrush}" />
                <ItemsControl ItemsSource="{Binding SemanticSuggestions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[UserControl].DataContext.OpenNoteByTitleOrPathCommand}"
                              CommandParameter="{Binding RelativePath}"
                              Classes="apple-btn-secondary"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,5" Margin="0,2">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding NoteTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AppleLinkBrush}" />
                          <TextBlock Text="{Binding SimilarityScore, StringFormat='Cosine similarity: {0:P0}'}" FontSize="10" Foreground="{DynamicResource AppleMutedBrush}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Local RAG Vault Copilot -->
            <Border Classes="apple-card" Padding="10,8">
              <StackPanel Spacing="6">
                <TextBlock Text="✦ LOCAL VAULT RAG COPILOT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleLinkBrush}" />
                <TextBox Text="{Binding CopilotPrompt}" FontSize="11.5" />
                <Button Content="Ask Vault with Citations" Command="{Binding ExecuteAskCopilotCommand}" Classes="apple-btn-primary" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding CopilotResponseText}" FontSize="11" Foreground="{DynamicResource AppleFg2Brush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ===================================================================== -->
      <!-- ROW 1: BOTTOM TELEMETRY & STATUS BAR (26px)                           -->
      <!-- ===================================================================== -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
              Background="{DynamicResource AppleSurfaceWarmBrush}"
              BorderBrush="{DynamicResource AppleBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding SaveTelemetryText}" FontSize="10.5" Foreground="{DynamicResource AppleSuccessBrush}" FontWeight="Medium" />
            <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
            <TextBlock Text="{Binding StatusBarRightText}" FontSize="10.5" Foreground="{DynamicResource AppleMutedBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="{Binding ObsidianBottomRightStatusText}"
                     FontSize="10.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppleFg2Brush}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- MODAL OVERLAY: SEARCHABLE COMMAND PALETTE (⌘P / Ctrl+P)                   -->
    <!-- ========================================================================= -->
    <Border IsVisible="{Binding IsCommandPaletteOpen}"
            Background="#88000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Width="580"
              VerticalAlignment="Top"
              Margin="0,80,0,0"
              Classes="apple-card"
              Padding="18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="⌘P Obsidian Command Palette &amp; Quick Switcher" Classes="display-heading" FontSize="16" />
            <Button Grid.Column="1" Content="✕ Esc" Command="{Binding CloseCommandPaletteCommand}" Classes="apple-btn-secondary" Padding="8,3" FontSize="11" />
          </Grid>

          <TextBox Text="{Binding CommandPaletteFilter, Mode=TwoWay}"
                   PlaceholderText="Type a note title, #tag, or command and press Enter…"
                   FontSize="13">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ExecuteFirstCommandPaletteMatchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>

          <ItemsControl ItemsSource="{Binding FilteredCommandPaletteNotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding $parent[UserControl].DataContext.OpenWikiLinkCommand}"
                        CommandParameter="{Binding}"
                        Classes="apple-btn-secondary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding Title, StringFormat='📄 {0}'}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource AppleMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
