<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Rhyolite"
             x:Class="Rhyolite.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Rhyolite.UI/Themes/AppleDesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <CornerRadius x:Key="AppleCardCornerRadius">12</CornerRadius>
      <CornerRadius x:Key="AppleBtnCornerRadius">8</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Multi-Design System Reusable Styles (feimacode/open-design-agent-kit) -->
    <Style Selector="Border.apple-card">
      <Setter Property="Background" Value="{DynamicResource AppleBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppleCardCornerRadius}" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.apple-surface-card">
      <Setter Property="Background" Value="{DynamicResource AppleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppleCardCornerRadius}" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.apple-pill">
      <Setter Property="CornerRadius" Value="980" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="Button.apple-btn-primary">
      <Setter Property="Background" Value="{DynamicResource AppleAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppleBtnCornerRadius}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.apple-btn-secondary">
      <Setter Property="Background" Value="{DynamicResource AppleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppleFgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppleBtnCornerRadius}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>
</Application>
