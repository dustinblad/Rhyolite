<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Rhyolite.ico</ApplicationIcon>
    <AssemblyName>Rhyolite</AssemblyName>
    <!-- Combine all managed .dlls and native runtime libraries into the application executable when publishing -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <Target Name="RemoveNativePdbsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LoosePdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_LoosePdbFiles)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rhyolite.Core\Rhyolite.Core.csproj" />
    <ProjectReference Include="..\Rhyolite.UI\Rhyolite.UI.csproj" />
  </ItemGroup>
</Project>
